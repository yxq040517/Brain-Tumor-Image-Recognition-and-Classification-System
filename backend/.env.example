# Copy to backend/.env only when overriding the local defaults.
# Relative paths resolve from the backend directory, not your terminal's cwd.
NEUROLENS_DATA_DIR=data
NEUROLENS_MODEL_DIR=models/brain-tumor-classifier
NEUROLENS_DEVICE=cpu
NEUROLENS_TORCH_THREADS=4

# Local uploads and active-model selection are stored in DATA_DIR/model-library.
# Upload and switch models from the model-status badge; MODEL_DIR keeps the pinned builtin.
#
# For a custom MODEL_DIR, prepare it explicitly using scripts/prepare_model.py --directory.
# The default launcher uses the pinned default directory above.
# The download endpoint is chosen by scripts/prepare_model.py; runtime inference has no network dependency.
