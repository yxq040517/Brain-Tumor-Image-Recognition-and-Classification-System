{
  "name": "neurolens",
  "version": "1.0.0",
  "private": true,
  "description": "Local brain MRI research workspace with real pinned open-source classification",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": ">=22"
  }
}
